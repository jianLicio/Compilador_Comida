PARSER_BEGIN(Comida)
package controle;

import java.util.HashMap;

public class Comida
{
  private static HashMap<String, Object> tabelaSimbolos = new HashMap<>();

  public static void armazenarVariavel(String nome, Object valor) {
    tabelaSimbolos.put(nome, valor);
  }

  public static Object recuperarVariavel(String nome) {
    return tabelaSimbolos.get(nome);
  }
  
  public static void main(String args []) throws ParseException
  {
    Comida parser = new Comida(System.in);
    while (true)
    {
      System.out.println("Sirva Seu Prato");
      try
      {
        Comida.programa();
        System.out.println("A MESA TA PRONTA.");
      }
      catch (Exception e)
      {
        System.out.println("Foi encontrado uva passa no arroz.");
        System.out.println(e.getMessage());
        Comida.ReInit(System.in);
      }
      catch (Error e)
      {
        System.out.println("FOI ENCONTRADO PURE NO CACHORRO QUENTE.");
        System.out.println(e.getMessage());
        break;
      }
    }
  }
}

