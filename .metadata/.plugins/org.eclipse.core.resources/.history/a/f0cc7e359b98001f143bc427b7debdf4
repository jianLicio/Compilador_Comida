void declaracao() :
{ Token nome; int valorInt; float valorFloat; boolean valorBoleano; float valorTemp; }
{
    ( pao() nome=<ID> igual() 
        { valorTemp = expressao(); }
        { valorInt = (int) valorTemp; } 
        pontoVirgula() enter() 
        { Comida.armazenarVariavel(nome.image, valorInt); } 
    )
|
    ( salame() nome=<ID> igual() valorFloat=expressao() pontoVirgula() enter() 
        { Comida.armazenarVariavel(nome.image, valorFloat); } 
    )
|
    ( linguica() nome=<ID> igual() 
        (valorBoleano=falso() | valorBoleano=verdadeiro()) 
        pontoVirgula() enter() 
        { Comida.armazenarVariavel(nome.image, valorBoleano); } 
    )
}

float expressao() :
{ float result; }
{
  result = sum() { return result; }
}

void atribuicao() :
{ }
{
  < ID > igual() expressao() pontoVirgula() enter()
}

float sum() :
{ float result; float termResult; }
{
  result = term()
  (
    (
      "+" termResult=term() { result += termResult; }
    | "-" termResult=term() { result -= termResult; }
    )
  )*
  { return result; }
}

float term() :
{ float result; float unaryResult; }
{
    result = unary()
    (
        (
            "*" unaryResult=unary() { result *= unaryResult; }
        | "/" unaryResult=unary() { result /= unaryResult; }
        )
    )*
    { return result; }
}

float unary() :
{
    Token minusToken;
}
{
    ( minusToken=<MINUS> element() { return -element(); } )
|
    ( <ABRE_PARENTESES> | <FALSO> | <VERDADEIRO> | <NUMERO> | <ID> ) {
        return element();
    }
}

float element() :
{ Token id; }
{
    <NUMERO> { return Float.parseFloat(token.image); }
|
    id=<ID> {
        Object valor = Comida.recuperarVariavel(id.image); 
        if (valor instanceof Integer) {
            // Converte Integer para Float explicitamente
            return (float) ((Integer) valor);
        } else if (valor instanceof Float) {
            // Retorna diretamente se já for float
            return (Float) valor;
        } else if (valor instanceof Boolean) {
            // Converte booleano para float: falso -> 0.0f, verdadeiro -> 1.0f
            return (Boolean) valor ? 1.0f : 0.0f;
        } else {
            throw new RuntimeException("Tipo não suportado para a variável " + id.image + ". Esperado Integer, Float ou Boolean.");
        }
    }
|
    falso() { return 0.0f; } // Representação de falso como 0.0f
| 
    verdadeiro() { return 1.0f; } // Representação de verdadeiro como 1.0f
| 
    abreParenteses() sum() fechaParenteses()
}
void condicional() :
{ }
{
  se() doisPontos() condicao()  abreChave() enter() comandos() enter() fechaChave() enter()
  ( seNao() abreChave() enter() comandos() enter() fechaChave() )? enter()
}

void condicao() :
{ }
{
  expressao() ( igualLogico() | diferente() | maior() | menor() | maiorIgual() | menorIgual() ) expressao()
}


void loop() :
{ }
{
  grelha() doisPontos() expressao() seta() condicao() seta() atribuicao()  abreChave() comandos() fechaChave()
| churrasqueira() abreParenteses() condicao() fechaParenteses() abreChave() enter() comandos() enter() fechaChave() enter()
}

